# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=wagering

# SQS (LocalStack)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localstack:4566
SQS_QUEUE_URL=http://localstack:4566/000000000000/wagering-queue
SQS_DLQ_URL=http://localstack:4566/000000000000/wagering-dlq

# Outbox
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100

# Consumer
CONSUMER_POLL_INTERVAL_MS=1000
CONSUMER_BATCH_SIZE=10
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_DELAY_MS=5000

# Retry Worker
RETRY_WORKER_INTERVAL_MS=30000
RETRY_WORKER_BATCH_SIZE=50

# Health
HEALTH_CHECK_INTERVAL_MS=5000